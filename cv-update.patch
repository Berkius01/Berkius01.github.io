+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font-family: Inter, Arial, Helvetica, sans-serif;
+  line-height: 1.6;
+  overflow-x: hidden;
+}
+a { color: inherit; text-decoration: none; }
+.container { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
+
+.grid-bg {
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
+  opacity: 0.16;
+  background-image:
+    linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
+  background-size: 44px 44px;
+  mask-image: linear-gradient(to bottom, black, transparent 72%);
+}
+
+.nav-wrap {
+  position: sticky;
+  top: 0;
+  z-index: 50;
+  background: rgba(9, 11, 14, 0.82);
+  backdrop-filter: blur(16px);
+  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
+}
+.nav {
+  height: 72px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 30px;
+}
+.brand { font-weight: 900; font-size: 24px; letter-spacing: -0.05em; }
+.brand span { color: var(--accent); }
+.nav-links { display: flex; gap: 24px; }
+.nav-links a,
+.nav-github {
+  font-size: 12px;
+  color: var(--muted);
+  transition: 0.2s;
+}
+.nav-links a:hover,
+.nav-github:hover { color: var(--accent); }
+
+.hero {
+  min-height: calc(100vh - 72px);
+  display: grid;
+  grid-template-columns: 1.2fr 0.8fr;
+  gap: 70px;
+  align-items: center;
+  padding: 80px 0;
+}
+.eyebrow,
+.section-label {
+  font: 700 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  letter-spacing: 0.13em;
+  color: var(--accent);
+}
+.eyebrow.dark { color: #29451b; }
+.hero h1 {
+  font-size: clamp(52px, 7.5vw, 96px);
+  line-height: 0.9;
+  letter-spacing: -0.065em;
+  margin: 20px 0 28px;
+}
+.hero h1 span,
+h2 span {
+  color: transparent;
+  -webkit-text-stroke: 1px #66717c;
+}
+.hero-text {
+  font-size: 19px;
+  color: #c3cbd3;
+  max-width: 720px;
+  margin: 0;
+}
+.hero-actions {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  margin-top: 32px;
+}
+.btn {
+  padding: 13px 18px;
+  border: 1px solid var(--line);
+  font-size: 13px;
+  font-weight: 800;
+}
+.btn.primary {
+  background: var(--accent);
+  color: #071006;
+  border-color: var(--accent);
+}
+.btn.ghost {
+  background: transparent;
+  color: var(--text);
